APP_NAME=resumen-service
DEBUG=false
# Clave de Google AI Studio: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
# Modelo disponible para tu cuenta (verificar con /v1beta/models):
GEMINI_MODEL=gemini-3.5-flash
API_V1_PREFIX=/api/v1

# Registro opcional en Consul (dejar vacío para desactivarlo)
CONSUL_HTTP_ADDR=
CONSUL_HTTP_TOKEN=
# Si se omite, el nombre será APP_NAME.
CONSUL_SERVICE_NAME=
CONSUL_SERVICE_PORT=8000
# Tags de Consul separados por comas (por ejemplo, etiquetas de Traefik).
CONSUL_SERVICE_TAGS=
# Si se omite, se detecta la IP local enrutable hacia Consul.
CONSUL_SERVICE_ADDRESS=
